{
  "version": 1,
  "items": [
    {"id":"family-001","phrase":"Rise and shine.","ipa":"/raɪz ənd ʃaɪn/","zh":"起床啦。","example":"Rise and shine! Breakfast is ready.","example_zh":"起床啦！早餐好了。","scene":"morning","level":"A2","tags":["routine","greeting"]},
    {"id":"family-002","phrase":"Time to get up.","ipa":"/taɪm tə ɡet ʌp/","zh":"该起床了。","example":"It's seven o'clock. Time to get up.","example_zh":"七点了，该起床了。","scene":"morning","level":"A2","tags":["routine","time"]},
    {"id":"family-003","phrase":"Get dressed.","ipa":"/ɡet drest/","zh":"穿好衣服。","example":"Get dressed, and then come downstairs.","example_zh":"穿好衣服，然后下楼。","scene":"morning","level":"A2","tags":["routine","clothes"]},
    {"id":"family-004","phrase":"Wash your face.","ipa":"/wɑːʃ jʊr feɪs/","zh":"洗洗脸。","example":"Wash your face and put on some lotion.","example_zh":"洗洗脸，再擦点润肤霜。","scene":"morning","level":"A2","tags":["hygiene","routine"]},
    {"id":"family-005","phrase":"Comb your hair.","ipa":"/koʊm jʊr her/","zh":"梳梳头。","example":"Comb your hair before we leave.","example_zh":"出门前把头发梳好。","scene":"morning","level":"A2","tags":["routine","appearance"]},
    {"id":"family-006","phrase":"Put on your shoes.","ipa":"/pʊt ɑːn jʊr ʃuːz/","zh":"把鞋穿上。","example":"Put on your shoes. We're leaving in five minutes.","example_zh":"把鞋穿上，我们五分钟后出发。","scene":"morning","level":"A2","tags":["clothes","routine"]},
    {"id":"family-007","phrase":"Have breakfast.","ipa":"/hæv ˈbrekfəst/","zh":"吃早餐。","example":"Have breakfast before you start your day.","example_zh":"开始新的一天前先吃早餐。","scene":"meals","level":"A2","tags":["meals","routine"]},
    {"id":"family-008","phrase":"Hurry up.","ipa":"/ˈhɜːri ʌp/","zh":"快一点。","example":"Hurry up, or we'll miss the bus.","example_zh":"快一点，不然我们会错过公交车。","scene":"morning","level":"A2","tags":["routine","time"]},
    {"id":"family-009","phrase":"You'll be late.","ipa":"/juːl bi leɪt/","zh":"你要迟到了。","example":"You'll be late if you don't get dressed now.","example_zh":"你现在还不穿衣服，就要迟到了。","scene":"morning","level":"A2","tags":["time","routine"]},
    {"id":"family-010","phrase":"Pack your bag.","ipa":"/pæk jʊr bæɡ/","zh":"收拾好书包。","example":"Pack your bag and check your homework.","example_zh":"收拾好书包，再检查一下作业。","scene":"morning","level":"A2","tags":["school","routine"]},
    {"id":"family-011","phrase":"Take your umbrella.","ipa":"/teɪk jʊr ʌmˈbrelə/","zh":"带上雨伞。","example":"It might rain later, so take your umbrella.","example_zh":"一会儿可能下雨，带上雨伞。","scene":"morning","level":"A2","tags":["weather","routine"]},
    {"id":"family-012","phrase":"Have a good day.","ipa":"/hæv ə ɡʊd deɪ/","zh":"祝你今天过得愉快。","example":"Have a good day at school!","example_zh":"祝你今天在学校过得愉快！","scene":"morning","level":"A2","tags":["greeting","school"]},
    {"id":"family-013","phrase":"See you later.","ipa":"/siː juː ˈleɪtər/","zh":"待会儿见。","example":"See you later. I'll pick you up after school.","example_zh":"待会儿见。放学后我来接你。","scene":"family","level":"A2","tags":["greeting","farewell"]},
    {"id":"family-014","phrase":"Have a safe trip.","ipa":"/hæv ə seɪf trɪp/","zh":"一路平安。","example":"Have a safe trip, and call me when you arrive.","example_zh":"一路平安，到了给我打电话。","scene":"family","level":"B1","tags":["farewell","safety"]},
    {"id":"family-015","phrase":"Text me when you get there.","ipa":"/tekst miː wen juː ɡet ðer/","zh":"到了给我发消息。","example":"Text me when you get there so I know you're safe.","example_zh":"到了给我发消息，让我知道你安全。","scene":"family","level":"B1","tags":["communication","safety"]},
    {"id":"family-016","phrase":"Breakfast is ready.","ipa":"/ˈbrekfəst ɪz ˈredi/","zh":"早餐好了。","example":"Breakfast is ready. Come and sit down.","example_zh":"早餐好了，过来坐下吃吧。","scene":"meals","level":"A2","tags":["meals","routine"]},
    {"id":"family-017","phrase":"Set the table.","ipa":"/set ðə ˈteɪbəl/","zh":"摆好餐具。","example":"Please set the table before dinner.","example_zh":"晚饭前请把餐具摆好。","scene":"meals","level":"A2","tags":["chores","meals"]},
    {"id":"family-018","phrase":"Help yourself.","ipa":"/help jʊrˈself/","zh":"自己拿，别客气。","example":"There's plenty of food, so help yourself.","example_zh":"食物很多，自己拿，别客气。","scene":"meals","level":"A2","tags":["meals","hospitality"]},
    {"id":"family-019","phrase":"Take small bites.","ipa":"/teɪk smɔːl baɪts/","zh":"小口吃。","example":"Take small bites and chew slowly.","example_zh":"小口吃，慢慢嚼。","scene":"meals","level":"A2","tags":["meals","safety"]},
    {"id":"family-020","phrase":"Eat your vegetables.","ipa":"/iːt jʊr ˈvedʒtəbəlz/","zh":"把蔬菜吃了。","example":"Eat your vegetables before you have dessert.","example_zh":"吃完蔬菜再吃甜点。","scene":"meals","level":"A2","tags":["meals","health"]},
    {"id":"family-021","phrase":"Drink some water.","ipa":"/drɪŋk səm ˈwɔːtər/","zh":"喝点水。","example":"Drink some water after you finish playing.","example_zh":"玩完后喝点水。","scene":"meals","level":"A2","tags":["health","meals"]},
    {"id":"family-022","phrase":"Don't eat too much.","ipa":"/doʊnt iːt tuː mʌtʃ/","zh":"别吃太多。","example":"Don't eat too much, or you'll feel uncomfortable.","example_zh":"别吃太多，不然会不舒服。","scene":"meals","level":"A2","tags":["meals","health"]},
    {"id":"family-023","phrase":"Clear the table.","ipa":"/klɪr ðə ˈteɪbəl/","zh":"收拾桌子。","example":"Clear the table after everyone finishes eating.","example_zh":"大家吃完后把桌子收拾干净。","scene":"chores","level":"A2","tags":["chores","meals"]},
    {"id":"family-024","phrase":"Wash the dishes.","ipa":"/wɑːʃ ðə ˈdɪʃɪz/","zh":"洗碗。","example":"I'll wash the dishes while you dry them.","example_zh":"我洗碗，你来擦干。","scene":"chores","level":"A2","tags":["chores","meals"]},
    {"id":"family-025","phrase":"Wipe the table.","ipa":"/waɪp ðə ˈteɪbəl/","zh":"把桌子擦一擦。","example":"Wipe the table with a clean cloth.","example_zh":"用干净的布把桌子擦一擦。","scene":"chores","level":"A2","tags":["chores","cleaning"]},
    {"id":"family-026","phrase":"Put it in the fridge.","ipa":"/pʊt ɪt ɪn ðə frɪdʒ/","zh":"把它放进冰箱。","example":"Put the milk in the fridge before it goes bad.","example_zh":"把牛奶放进冰箱，别坏了。","scene":"meals","level":"A2","tags":["food","storage"]},
    {"id":"family-027","phrase":"It's still hot.","ipa":"/ɪts stɪl hɑːt/","zh":"还很烫。","example":"Wait a minute. It's still hot.","example_zh":"等一下，还很烫。","scene":"meals","level":"A2","tags":["meals","safety"]},
    {"id":"family-028","phrase":"It smells good.","ipa":"/ɪt smelz ɡʊd/","zh":"闻起来很香。","example":"It smells good. What are you making?","example_zh":"闻起来很香，你在做什么？","scene":"meals","level":"A2","tags":["meals","senses"]},
    {"id":"family-029","phrase":"I'm full.","ipa":"/aɪm fʊl/","zh":"我吃饱了。","example":"No more for me, thanks. I'm full.","example_zh":"我不用了，谢谢，我吃饱了。","scene":"meals","level":"A2","tags":["meals","feelings"]},
    {"id":"family-030","phrase":"Would you like some more?","ipa":"/wʊd juː laɪk səm mɔːr/","zh":"你还要一点吗？","example":"Would you like some more rice?","example_zh":"你还要一点米饭吗？","scene":"meals","level":"A2","tags":["meals","offer"]},
    {"id":"family-031","phrase":"Finish your milk.","ipa":"/ˈfɪnɪʃ jʊr mɪlk/","zh":"把牛奶喝完。","example":"Finish your milk before you go and play.","example_zh":"把牛奶喝完再去玩。","scene":"meals","level":"A2","tags":["meals","routine"]},
    {"id":"family-032","phrase":"Pass me the spoon.","ipa":"/pæs miː ðə spuːn/","zh":"把勺子递给我。","example":"Could you pass me the spoon, please?","example_zh":"请把勺子递给我，好吗？","scene":"meals","level":"A2","tags":["meals","request"]},
    {"id":"family-033","phrase":"Do your homework.","ipa":"/duː jʊr ˈhoʊmwɜːrk/","zh":"做作业。","example":"Do your homework before you watch TV.","example_zh":"先做作业，再看电视。","scene":"learning","level":"A2","tags":["school","routine"]},
    {"id":"family-034","phrase":"Read a book.","ipa":"/riːd ə bʊk/","zh":"看会儿书。","example":"Read a book for twenty minutes before bed.","example_zh":"睡前看二十分钟书。","scene":"learning","level":"A2","tags":["reading","routine"]},
    {"id":"family-035","phrase":"Practice the piano.","ipa":"/ˈpræktɪs ðə piˈænoʊ/","zh":"练钢琴。","example":"Practice the piano for half an hour today.","example_zh":"今天练半小时钢琴。","scene":"learning","level":"A2","tags":["practice","music"]},
    {"id":"family-036","phrase":"Finish your homework.","ipa":"/ˈfɪnɪʃ jʊr ˈhoʊmwɜːrk/","zh":"把作业做完。","example":"Finish your homework before dinner.","example_zh":"晚饭前把作业做完。","scene":"learning","level":"A2","tags":["school","routine"]},
    {"id":"family-037","phrase":"Take a break.","ipa":"/teɪk ə breɪk/","zh":"休息一下。","example":"You've been studying for an hour. Take a break.","example_zh":"你已经学了一小时了，休息一下吧。","scene":"learning","level":"A2","tags":["study","wellbeing"]},
    {"id":"family-038","phrase":"Good job.","ipa":"/ɡʊd dʒɑːb/","zh":"做得好。","example":"Good job! You worked really hard on that.","example_zh":"做得好！你很努力。","scene":"learning","level":"A2","tags":["praise","feedback"]},
    {"id":"family-039","phrase":"Well done.","ipa":"/wel dʌn/","zh":"做得很好。","example":"Well done on your spelling test.","example_zh":"你的拼写测试做得很好。","scene":"learning","level":"A2","tags":["praise","school"]},
    {"id":"family-040","phrase":"Try again.","ipa":"/traɪ əˈɡen/","zh":"再试一次。","example":"That was close. Try again.","example_zh":"很接近了，再试一次。","scene":"learning","level":"A2","tags":["practice","encouragement"]},
    {"id":"family-041","phrase":"You can do it.","ipa":"/juː kæn duː ɪt/","zh":"你可以做到。","example":"Take your time. You can do it.","example_zh":"慢慢来，你可以做到。","scene":"learning","level":"A2","tags":["encouragement","confidence"]},
    {"id":"family-042","phrase":"Don't give up.","ipa":"/doʊnt ɡɪv ʌp/","zh":"别放弃。","example":"Don't give up. Keep trying.","example_zh":"别放弃，继续试。","scene":"learning","level":"A2","tags":["encouragement","perseverance"]},
    {"id":"family-043","phrase":"What do you think?","ipa":"/wʌt duː juː θɪŋk/","zh":"你觉得呢？","example":"What do you think we should do next?","example_zh":"你觉得我们接下来该怎么做？","scene":"family","level":"A2","tags":["discussion","opinion"]},
    {"id":"family-044","phrase":"Tell me more.","ipa":"/tel miː mɔːr/","zh":"再多说说。","example":"That sounds interesting. Tell me more.","example_zh":"听起来很有意思，再多说说。","scene":"family","level":"A2","tags":["conversation","interest"]},
    {"id":"family-045","phrase":"Listen carefully.","ipa":"/ˈlɪsən ˈkerfəli/","zh":"仔细听。","example":"Listen carefully so you know what to do.","example_zh":"仔细听，这样你就知道该怎么做了。","scene":"learning","level":"A2","tags":["listening","instructions"]},
    {"id":"family-046","phrase":"Speak slowly.","ipa":"/spiːk ˈsloʊli/","zh":"慢点说。","example":"Speak slowly and take a breath.","example_zh":"慢点说，深呼吸一下。","scene":"learning","level":"A2","tags":["speaking","confidence"]},
    {"id":"family-047","phrase":"Say it again.","ipa":"/seɪ ɪt əˈɡen/","zh":"再说一遍。","example":"I didn't catch that. Say it again, please.","example_zh":"我没听清，请再说一遍。","scene":"family","level":"A2","tags":["communication","listening"]},
    {"id":"family-048","phrase":"Let's read together.","ipa":"/lets riːd təˈɡeðər/","zh":"我们一起读吧。","example":"Let's read together before bedtime.","example_zh":"睡前我们一起读吧。","scene":"learning","level":"A2","tags":["reading","family"]},
    {"id":"family-049","phrase":"Show me your drawing.","ipa":"/ʃoʊ miː jʊr ˈdrɔːɪŋ/","zh":"给我看看你的画。","example":"Show me your drawing. I'd love to see it.","example_zh":"给我看看你的画，我很想看。","scene":"learning","level":"A2","tags":["creativity","family"]},
    {"id":"family-050","phrase":"What did you learn today?","ipa":"/wʌt dɪd juː lɜːrn təˈdeɪ/","zh":"你今天学了什么？","example":"What did you learn today at school?","example_zh":"你今天在学校学了什么？","scene":"learning","level":"A2","tags":["school","conversation"]},
    {"id":"family-051","phrase":"Clean up your room.","ipa":"/kliːn ʌp jʊr ruːm/","zh":"把你的房间收拾干净。","example":"Clean up your room before you go out.","example_zh":"出门前把你的房间收拾干净。","scene":"chores","level":"A2","tags":["cleaning","responsibility"]},
    {"id":"family-052","phrase":"Tidy up.","ipa":"/ˈtaɪdi ʌp/","zh":"收拾整齐。","example":"Let's tidy up before Grandma arrives.","example_zh":"奶奶来之前我们收拾一下吧。","scene":"chores","level":"A2","tags":["cleaning","routine"]},
    {"id":"family-053","phrase":"Put away your toys.","ipa":"/pʊt əˈweɪ jʊr tɔɪz/","zh":"把玩具收好。","example":"Put away your toys when you finish playing.","example_zh":"玩完后把玩具收好。","scene":"chores","level":"A2","tags":["cleaning","toys"]},
    {"id":"family-054","phrase":"Pick up your toys.","ipa":"/pɪk ʌp jʊr tɔɪz/","zh":"把玩具捡起来。","example":"Pick up your toys from the floor.","example_zh":"把地上的玩具捡起来。","scene":"chores","level":"A2","tags":["cleaning","toys"]},
    {"id":"family-055","phrase":"Make your bed.","ipa":"/meɪk jʊr bed/","zh":"整理床铺。","example":"Make your bed after you get up.","example_zh":"起床后把床铺整理好。","scene":"chores","level":"A2","tags":["routine","responsibility"]},
    {"id":"family-056","phrase":"Throw it in the bin.","ipa":"/θroʊ ɪt ɪn ðə bɪn/","zh":"把它扔进垃圾桶。","example":"Don't leave the wrapper there. Throw it in the bin.","example_zh":"别把包装纸放那儿，扔进垃圾桶。","scene":"chores","level":"A2","tags":["cleaning","waste"]},
    {"id":"family-057","phrase":"Put your clothes away.","ipa":"/pʊt jʊr kloʊðz əˈweɪ/","zh":"把你的衣服收好。","example":"Put your clothes away instead of leaving them on the chair.","example_zh":"把衣服收好，别放在椅子上。","scene":"chores","level":"A2","tags":["clothes","cleaning"]},
    {"id":"family-058","phrase":"Fold your clothes.","ipa":"/foʊld jʊr kloʊðz/","zh":"把衣服叠好。","example":"Fold your clothes and put them in the drawer.","example_zh":"把衣服叠好放进抽屉。","scene":"chores","level":"A2","tags":["clothes","chores"]},
    {"id":"family-059","phrase":"Water the plants.","ipa":"/ˈwɔːtər ðə plænts/","zh":"给植物浇水。","example":"Water the plants before we leave.","example_zh":"我们出门前给植物浇水。","scene":"chores","level":"A2","tags":["plants","responsibility"]},
    {"id":"family-060","phrase":"Feed the cat.","ipa":"/fiːd ðə kæt/","zh":"喂猫。","example":"Don't forget to feed the cat.","example_zh":"别忘了喂猫。","scene":"chores","level":"A2","tags":["pets","routine"]},
    {"id":"family-061","phrase":"Help me with the dishes.","ipa":"/help miː wɪð ðə ˈdɪʃɪz/","zh":"帮我一起洗碗。","example":"Could you help me with the dishes after dinner?","example_zh":"晚饭后你能帮我一起洗碗吗？","scene":"chores","level":"A2","tags":["chores","help"]},
    {"id":"family-062","phrase":"Take out the trash.","ipa":"/teɪk aʊt ðə træʃ/","zh":"把垃圾拿出去。","example":"Please take out the trash before it gets dark.","example_zh":"天黑前请把垃圾拿出去。","scene":"chores","level":"A2","tags":["chores","waste"]},
    {"id":"family-063","phrase":"Sweep the floor.","ipa":"/swiːp ðə flɔːr/","zh":"扫地。","example":"I'll sweep the floor while you tidy the table.","example_zh":"你收拾桌子，我来扫地。","scene":"chores","level":"A2","tags":["cleaning","home"]},
    {"id":"family-064","phrase":"Put your shoes by the door.","ipa":"/pʊt jʊr ʃuːz baɪ ðə dɔːr/","zh":"把鞋放在门边。","example":"Put your shoes by the door so nobody trips.","example_zh":"把鞋放在门边，免得有人绊倒。","scene":"chores","level":"A2","tags":["home","organization"]},
    {"id":"family-065","phrase":"Don't leave your things everywhere.","ipa":"/doʊnt liːv jʊr θɪŋz ˈevriwer/","zh":"别把东西到处乱放。","example":"Don't leave your things everywhere. Put them away.","example_zh":"别把东西到处乱放，把它们收好。","scene":"chores","level":"B1","tags":["organization","responsibility"]},
    {"id":"family-066","phrase":"Everything has its place.","ipa":"/ˈevriθɪŋ hæz ɪts pleɪs/","zh":"每样东西都有它该放的地方。","example":"Everything has its place, so put the scissors back.","example_zh":"每样东西都有地方放，把剪刀放回去。","scene":"chores","level":"B1","tags":["organization","home"]},
    {"id":"family-067","phrase":"Let's clean up together.","ipa":"/lets kliːn ʌp təˈɡeðər/","zh":"我们一起收拾吧。","example":"Let's clean up together, and then we can relax.","example_zh":"我们一起收拾，然后就能休息了。","scene":"chores","level":"A2","tags":["teamwork","cleaning"]},
    {"id":"family-068","phrase":"You can help me.","ipa":"/juː kæn help miː/","zh":"你可以帮我。","example":"You can help me carry these bags.","example_zh":"你可以帮我拿这些袋子。","scene":"family","level":"A2","tags":["help","request"]},
    {"id":"family-069","phrase":"Wash your hands.","ipa":"/wɑːʃ jʊr hændz/","zh":"洗手。","example":"Wash your hands before you eat.","example_zh":"吃饭前先洗手。","scene":"safety","level":"A2","tags":["hygiene","health"]},
    {"id":"family-070","phrase":"Be careful.","ipa":"/biː ˈkerfəl/","zh":"小心一点。","example":"Be careful with that hot pan.","example_zh":"小心那个热锅。","scene":"safety","level":"A2","tags":["safety","warning"]},
    {"id":"family-071","phrase":"Watch out.","ipa":"/wɑːtʃ aʊt/","zh":"当心！","example":"Watch out! There's a car coming.","example_zh":"当心！有车来了。","scene":"safety","level":"A2","tags":["safety","warning"]},
    {"id":"family-072","phrase":"Don't touch that.","ipa":"/doʊnt tʌtʃ ðæt/","zh":"别碰那个。","example":"Don't touch that. It's very hot.","example_zh":"别碰那个，很烫。","scene":"safety","level":"A2","tags":["safety","warning"]},
    {"id":"family-073","phrase":"Stay close to me.","ipa":"/steɪ kloʊs tə miː/","zh":"跟紧我。","example":"Stay close to me in the shopping mall.","example_zh":"在商场里跟紧我。","scene":"safety","level":"A2","tags":["safety","outdoors"]},
    {"id":"family-074","phrase":"Hold my hand.","ipa":"/hoʊld maɪ hænd/","zh":"牵着我的手。","example":"Hold my hand while we cross the road.","example_zh":"过马路时牵着我的手。","scene":"safety","level":"A2","tags":["safety","outdoors"]},
    {"id":"family-075","phrase":"Don't run.","ipa":"/doʊnt rʌn/","zh":"不要跑。","example":"Don't run near the swimming pool.","example_zh":"游泳池边不要跑。","scene":"safety","level":"A2","tags":["safety","movement"]},
    {"id":"family-076","phrase":"Slow down.","ipa":"/sloʊ daʊn/","zh":"慢一点。","example":"Slow down. The floor is wet.","example_zh":"慢一点，地板是湿的。","scene":"safety","level":"A2","tags":["safety","speed"]},
    {"id":"family-077","phrase":"Wait for me.","ipa":"/weɪt fɔːr miː/","zh":"等等我。","example":"Wait for me at the entrance.","example_zh":"在入口处等我。","scene":"safety","level":"A2","tags":["waiting","family"]},
    {"id":"family-078","phrase":"Look both ways.","ipa":"/lʊk boʊθ weɪz/","zh":"左右看看。","example":"Look both ways before you cross the street.","example_zh":"过马路前左右看看。","scene":"safety","level":"A2","tags":["road safety","outdoors"]},
    {"id":"family-079","phrase":"Wait for the green light.","ipa":"/weɪt fɔːr ðə ɡriːn laɪt/","zh":"等绿灯再走。","example":"Wait for the green light before crossing.","example_zh":"过马路前等绿灯。","scene":"safety","level":"A2","tags":["road safety","outdoors"]},
    {"id":"family-080","phrase":"Cross the street with me.","ipa":"/krɔːs ðə striːt wɪð miː/","zh":"和我一起过马路。","example":"Cross the street with me, not by yourself.","example_zh":"和我一起过马路，不要自己过。","scene":"safety","level":"A2","tags":["road safety","family"]},
    {"id":"family-081","phrase":"Fasten your seat belt.","ipa":"/ˈfæsən jʊr siːt belt/","zh":"系好安全带。","example":"Fasten your seat belt before we start driving.","example_zh":"开车前系好安全带。","scene":"safety","level":"A2","tags":["car","safety"]},
    {"id":"family-082","phrase":"Keep your voice down.","ipa":"/kiːp jʊr vɔɪs daʊn/","zh":"说话小声一点。","example":"Keep your voice down. The baby is sleeping.","example_zh":"说话小声一点，宝宝在睡觉。","scene":"safety","level":"A2","tags":["manners","volume"]},
    {"id":"family-083","phrase":"Don't wander off.","ipa":"/doʊnt ˈwɑːndər ɔːf/","zh":"不要乱跑走远。","example":"Stay with us and don't wander off.","example_zh":"和我们待在一起，不要乱跑走远。","scene":"safety","level":"B1","tags":["outdoors","safety"]},
    {"id":"family-084","phrase":"Stay where I can see you.","ipa":"/steɪ wer aɪ kæn siː juː/","zh":"待在我能看见你的地方。","example":"Stay where I can see you while I pay.","example_zh":"我付钱时待在我能看见你的地方。","scene":"safety","level":"B1","tags":["outdoors","safety"]},
    {"id":"family-085","phrase":"Share with others.","ipa":"/ʃer wɪð ˈʌðərz/","zh":"和别人分享。","example":"Share with others and wait for your turn.","example_zh":"和别人分享，按顺序来。","scene":"emotions","level":"A2","tags":["sharing","social skills"]},
    {"id":"family-086","phrase":"Take turns.","ipa":"/teɪk tɜːrnz/","zh":"轮流来。","example":"Take turns with the toy, please.","example_zh":"请轮流玩这个玩具。","scene":"emotions","level":"A2","tags":["sharing","social skills"]},
    {"id":"family-087","phrase":"Say sorry.","ipa":"/seɪ ˈsɑːri/","zh":"说对不起。","example":"You hurt her feelings. Say sorry.","example_zh":"你伤到她的感受了，说对不起。","scene":"emotions","level":"A2","tags":["apology","manners"]},
    {"id":"family-088","phrase":"That's okay.","ipa":"/ðæts oʊˈkeɪ/","zh":"没关系。","example":"That's okay. Everyone makes mistakes.","example_zh":"没关系，每个人都会犯错。","scene":"emotions","level":"A2","tags":["reassurance","forgiveness"]},
    {"id":"family-089","phrase":"Don't be afraid.","ipa":"/doʊnt bi əˈfreɪd/","zh":"别害怕。","example":"Don't be afraid. I'm right here with you.","example_zh":"别害怕，我就在你身边。","scene":"emotions","level":"A2","tags":["comfort","fear"]},
    {"id":"family-090","phrase":"It's not a big deal.","ipa":"/ɪts nɑːt ə bɪɡ diːl/","zh":"没什么大不了的。","example":"It's not a big deal. We can fix it.","example_zh":"没什么大不了的，我们可以修好。","scene":"emotions","level":"B1","tags":["reassurance","problem solving"]},
    {"id":"family-091","phrase":"I'm proud of you.","ipa":"/aɪm praʊd əv juː/","zh":"我为你骄傲。","example":"I'm proud of you for telling the truth.","example_zh":"你说了真话，我为你骄傲。","scene":"emotions","level":"A2","tags":["praise","support"]},
    {"id":"family-092","phrase":"How was your day?","ipa":"/haʊ wəz jʊr deɪ/","zh":"你今天过得怎么样？","example":"How was your day at school?","example_zh":"你今天在学校过得怎么样？","scene":"emotions","level":"A2","tags":["conversation","school"]},
    {"id":"family-093","phrase":"What's the matter?","ipa":"/wʌts ðə ˈmætər/","zh":"怎么了？","example":"You look upset. What's the matter?","example_zh":"你看起来不开心，怎么了？","scene":"emotions","level":"A2","tags":["feelings","conversation"]},
    {"id":"family-094","phrase":"Are you okay?","ipa":"/ɑːr juː oʊˈkeɪ/","zh":"你还好吗？","example":"You fell down. Are you okay?","example_zh":"你摔倒了，还好吗？","scene":"emotions","level":"A2","tags":["concern","safety"]},
    {"id":"family-095","phrase":"Take a deep breath.","ipa":"/teɪk ə diːp breθ/","zh":"深呼吸一下。","example":"Take a deep breath and tell me what happened.","example_zh":"深呼吸一下，告诉我发生了什么。","scene":"emotions","level":"A2","tags":["calm","self-regulation"]},
    {"id":"family-096","phrase":"Calm down.","ipa":"/kɑːm daʊn/","zh":"冷静下来。","example":"Calm down and use your words.","example_zh":"冷静下来，把话说清楚。","scene":"emotions","level":"A2","tags":["calm","self-regulation"]},
    {"id":"family-097","phrase":"I understand.","ipa":"/aɪ ˌʌndərˈstænd/","zh":"我理解。","example":"I understand why you're upset.","example_zh":"我理解你为什么难过。","scene":"emotions","level":"A2","tags":["empathy","understanding"]},
    {"id":"family-098","phrase":"I'm here for you.","ipa":"/aɪm hɪr fɔːr juː/","zh":"我在你身边支持你。","example":"Whatever happens, I'm here for you.","example_zh":"无论发生什么，我都支持你。","scene":"emotions","level":"B1","tags":["support","reassurance"]},
    {"id":"family-099","phrase":"Let's talk about it.","ipa":"/lets tɔːk əˈbaʊt ɪt/","zh":"我们谈谈这件事吧。","example":"Let's talk about it when you feel ready.","example_zh":"等你准备好，我们谈谈这件事吧。","scene":"emotions","level":"A2","tags":["communication","problem solving"]},
    {"id":"family-100","phrase":"That's a good idea.","ipa":"/ðæts ə ɡʊd aɪˈdɪə/","zh":"那是个好主意。","example":"That's a good idea. Let's try it.","example_zh":"那是个好主意，我们试试吧。","scene":"family","level":"A2","tags":["agreement","ideas"]},
    {"id":"family-101","phrase":"I appreciate that.","ipa":"/aɪ əˈpriːʃieɪt ðæt/","zh":"我很感激。","example":"Thank you for helping me. I appreciate that.","example_zh":"谢谢你帮我，我很感激。","scene":"family","level":"B1","tags":["gratitude","relationship"]},
    {"id":"family-102","phrase":"Thank you for helping.","ipa":"/θæŋk juː fɔːr ˈhelpɪŋ/","zh":"谢谢你帮忙。","example":"Thank you for helping me clean up.","example_zh":"谢谢你帮我收拾。","scene":"family","level":"A2","tags":["gratitude","help"]},
    {"id":"family-103","phrase":"Please wait a moment.","ipa":"/pliːz weɪt ə ˈmoʊmənt/","zh":"请等一下。","example":"Please wait a moment. I'm finishing this call.","example_zh":"请等一下，我把电话打完。","scene":"family","level":"A2","tags":["patience","request"]},
    {"id":"family-104","phrase":"Could you give me a hand?","ipa":"/kʊd juː ɡɪv miː ə hænd/","zh":"你能帮我一下吗？","example":"Could you give me a hand with this box?","example_zh":"你能帮我搬一下这个箱子吗？","scene":"family","level":"B1","tags":["request","help"]},
    {"id":"family-105","phrase":"No worries.","ipa":"/noʊ ˈwɜːriz/","zh":"没关系，别担心。","example":"No worries. We can do it tomorrow.","example_zh":"没关系，我们可以明天做。","scene":"family","level":"A2","tags":["reassurance","conversation"]},
    {"id":"family-106","phrase":"Let's go.","ipa":"/lets ɡoʊ/","zh":"我们走吧。","example":"Let's go. The bus will be here soon.","example_zh":"我们走吧，公交车快到了。","scene":"outdoors","level":"A2","tags":["movement","routine"]},
    {"id":"family-107","phrase":"We're leaving soon.","ipa":"/wɪr ˈliːvɪŋ suːn/","zh":"我们快出发了。","example":"We're leaving soon, so get your bag ready.","example_zh":"我们快出发了，把包准备好。","scene":"outdoors","level":"A2","tags":["departure","routine"]},
    {"id":"family-108","phrase":"Get in the car.","ipa":"/ɡet ɪn ðə kɑːr/","zh":"上车。","example":"Get in the car and close the door.","example_zh":"上车，把门关上。","scene":"outdoors","level":"A2","tags":["car","movement"]},
    {"id":"family-109","phrase":"We're almost there.","ipa":"/wɪr ˈɔːlmoʊst ðer/","zh":"我们快到了。","example":"Don't worry. We're almost there.","example_zh":"别着急，我们快到了。","scene":"outdoors","level":"A2","tags":["travel","reassurance"]},
    {"id":"family-110","phrase":"Let's take a walk.","ipa":"/lets teɪk ə wɔːk/","zh":"我们去散步吧。","example":"The weather is nice. Let's take a walk.","example_zh":"天气很好，我们去散步吧。","scene":"outdoors","level":"A2","tags":["exercise","outdoors"]},
    {"id":"family-111","phrase":"Let's go home.","ipa":"/lets ɡoʊ hoʊm/","zh":"我们回家吧。","example":"It's getting dark. Let's go home.","example_zh":"天快黑了，我们回家吧。","scene":"outdoors","level":"A2","tags":["home","departure"]},
    {"id":"family-112","phrase":"It's time to go.","ipa":"/ɪts taɪm tə ɡoʊ/","zh":"该走了。","example":"It's time to go. Put on your coat.","example_zh":"该走了，把外套穿上。","scene":"outdoors","level":"A2","tags":["time","departure"]},
    {"id":"family-113","phrase":"Keep up with me.","ipa":"/kiːp ʌp wɪð miː/","zh":"跟上我。","example":"Keep up with me so we don't get separated.","example_zh":"跟上我，免得我们走散。","scene":"outdoors","level":"B1","tags":["movement","safety"]},
    {"id":"family-114","phrase":"Wait your turn.","ipa":"/weɪt jʊr tɜːrn/","zh":"等轮到你。","example":"Wait your turn and don't push.","example_zh":"等轮到你，不要推。","scene":"outdoors","level":"A2","tags":["patience","manners"]},
    {"id":"family-115","phrase":"Let's meet at the entrance.","ipa":"/lets miːt æt ðə ˈentrəns/","zh":"我们在入口见吧。","example":"If we get separated, let's meet at the entrance.","example_zh":"如果我们走散，就在入口见。","scene":"outdoors","level":"B1","tags":["meeting point","safety"]},
    {"id":"family-116","phrase":"Take a bath.","ipa":"/teɪk ə bæθ/","zh":"洗个澡。","example":"Take a bath before you put on your pajamas.","example_zh":"先洗个澡，再穿睡衣。","scene":"bedtime","level":"A2","tags":["hygiene","routine"]},
    {"id":"family-117","phrase":"Put on your pajamas.","ipa":"/pʊt ɑːn jʊr pəˈdʒɑːməz/","zh":"穿上睡衣。","example":"Put on your pajamas and brush your teeth.","example_zh":"穿上睡衣，然后刷牙。","scene":"bedtime","level":"A2","tags":["clothes","routine"]},
    {"id":"family-118","phrase":"Turn off the light.","ipa":"/tɜːrn ɔːf ðə laɪt/","zh":"把灯关掉。","example":"Turn off the light when you leave the room.","example_zh":"离开房间时把灯关掉。","scene":"bedtime","level":"A2","tags":["home","energy"]},
    {"id":"family-119","phrase":"Go to bed.","ipa":"/ɡoʊ tə bed/","zh":"去睡觉。","example":"It's late. Go to bed now.","example_zh":"很晚了，现在去睡觉。","scene":"bedtime","level":"A2","tags":["bedtime","routine"]},
    {"id":"family-120","phrase":"It's bedtime.","ipa":"/ɪts ˈbedtaɪm/","zh":"该睡觉了。","example":"It's bedtime. Put your book away.","example_zh":"该睡觉了，把书收起来。","scene":"bedtime","level":"A2","tags":["bedtime","routine"]},
    {"id":"family-121","phrase":"Close your eyes.","ipa":"/kloʊz jʊr aɪz/","zh":"闭上眼睛。","example":"Close your eyes and relax.","example_zh":"闭上眼睛，放松一下。","scene":"bedtime","level":"A2","tags":["sleep","relaxation"]},
    {"id":"family-122","phrase":"Sleep tight.","ipa":"/sliːp taɪt/","zh":"睡个好觉。","example":"Good night. Sleep tight.","example_zh":"晚安，睡个好觉。","scene":"bedtime","level":"A2","tags":["bedtime","farewell"]},
    {"id":"family-123","phrase":"I'll be right here.","ipa":"/aɪl bi raɪt hɪr/","zh":"我就在这里。","example":"Don't worry. I'll be right here.","example_zh":"别担心，我就在这里。","scene":"bedtime","level":"A2","tags":["reassurance","sleep"]},
    {"id":"family-124","phrase":"Good night.","ipa":"/ɡʊd naɪt/","zh":"晚安。","example":"Good night. I'll see you in the morning.","example_zh":"晚安，明早见。","scene":"bedtime","level":"A2","tags":["greeting","bedtime"]},
    {"id":"family-125","phrase":"Sweet dreams.","ipa":"/swiːt driːmz/","zh":"做个好梦。","example":"Good night, sweetheart. Sweet dreams.","example_zh":"晚安，宝贝，做个好梦。","scene":"bedtime","level":"A2","tags":["bedtime","affection"]},
    {"id":"family-126","phrase":"Do you want a bedtime story?","ipa":"/duː juː wɑːnt ə ˈbedtaɪm ˈstɔːri/","zh":"你想听睡前故事吗？","example":"Do you want a bedtime story before you sleep?","example_zh":"睡觉前你想听个睡前故事吗？","scene":"bedtime","level":"A2","tags":["reading","bedtime"]},
    {"id":"family-127","phrase":"One more story.","ipa":"/wʌn mɔːr ˈstɔːri/","zh":"再讲一个故事。","example":"Just one more story, and then it's time to sleep.","example_zh":"再讲一个故事，然后就睡觉。","scene":"bedtime","level":"A2","tags":["reading","bedtime"]},
    {"id":"family-128","phrase":"It's time to sleep.","ipa":"/ɪts taɪm tə sliːp/","zh":"该睡觉了。","example":"It's time to sleep. Close your eyes.","example_zh":"该睡觉了，闭上眼睛。","scene":"bedtime","level":"A2","tags":["sleep","routine"]},
    {"id":"family-129","phrase":"Pull up the blanket.","ipa":"/pʊl ʌp ðə ˈblæŋkɪt/","zh":"把被子拉上来。","example":"Pull up the blanket so you stay warm.","example_zh":"把被子拉上来，这样暖和些。","scene":"bedtime","level":"A2","tags":["bedtime","comfort"]},
    {"id":"family-130","phrase":"I love you.","ipa":"/aɪ lʌv juː/","zh":"我爱你。","example":"I love you. Sleep well.","example_zh":"我爱你，好好睡。","scene":"bedtime","level":"A2","tags":["affection","family"]}
  ]
}
